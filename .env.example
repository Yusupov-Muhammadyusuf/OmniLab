# GitHub Models token with Models read permission.
GITHUB_MODELS_API_KEY=your_github_models_api_key

# Existing deployments may continue using this legacy key name during migration.
FEATHERLESS_AI_API=your_github_models_api_key

# Optional provider overrides.
OMNILAB_AI_BASE_URL=https://models.github.ai/inference
OMNILAB_AI_MODEL=openai/gpt-4o-mini

# Optional anonymous reaction-analysis limits. Defaults allow 60 analyses from
# one network address in each 10-minute window.
OMNILAB_REACTION_RATE_LIMIT_REQUESTS=60
OMNILAB_REACTION_RATE_LIMIT_WINDOW_SECONDS=600

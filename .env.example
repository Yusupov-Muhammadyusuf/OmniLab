# The only supported credential for future AI-backed functionality.
# Use a GitHub token with Models read permission.
GITHUB_MODELS_API_KEY=your_github_models_api_key

# Optional anonymous reaction-analysis limits. Defaults allow 60 analyses from
# one network address in each 10-minute window.
OMNILAB_REACTION_RATE_LIMIT_REQUESTS=60
OMNILAB_REACTION_RATE_LIMIT_WINDOW_SECONDS=600
